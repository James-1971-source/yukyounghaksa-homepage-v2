rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /notices/{docId} {
      allow read, write: if true;
    }
    match /stories/{docId} {
      allow read, write: if true;
    }
    match /donations/{docId} {
      allow read, write: if true;
    }
    match /volunteers/{docId} {
      allow read, write: if true;
    }
  }
}
